# Database
DATABASE_URL=postgresql+asyncpg://darwin:darwin@localhost:5432/darwin

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Simulation
STARTING_CAPITAL=10.00
SURVIVAL_TAX=0.50
TAX_INTERVAL_TURNS=10
MAX_TURNS=500
APEX_WEALTH_FRACTION=0.90

# Stub mode runs the sim with deterministic fake LLM responses (no API keys needed).
# Set to false once real keys are configured below.
STUB_MODE=true

# LLM provider keys — leave blank to fall back to stub for that agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=

# Model IDs (override here when newer SOTA drops)
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-3.1-pro-preview
GROK_MODEL=grok-4.3

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Vector memory
CHROMA_PATH=./chroma

# --- Dynamic agent configuration -------------------------------------------
# Fernet key for encrypting stored API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Agent count limits (enforced by POST /configure)
MIN_AGENTS=3
MAX_AGENTS=10

# Consecutive API errors before pausing simulation
ERROR_THRESHOLD=3
