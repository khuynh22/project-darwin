# Database
DATABASE_URL=postgresql+asyncpg://darwin:darwin@localhost:5432/darwin

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Simulation
STARTING_CAPITAL=10.00
SURVIVAL_TAX=0.50
TAX_INTERVAL_TURNS=10
MAX_TURNS=500
APEX_WEALTH_FRACTION=0.90

# --- Models (OpenRouter) — operator/CLI fallback; per-session BYOK in the UI ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-4.7

# --- Dynamic agent configuration -------------------------------------------
# Fernet key for encrypting stored API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Agent count limits (enforced by POST /configure)
MIN_AGENTS=3
MAX_AGENTS=10

# Consecutive API errors before pausing simulation
ERROR_THRESHOLD=3
