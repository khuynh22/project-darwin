# Project Darwin — copy to .env and fill in your config.
#
# Models are reached through OpenRouter (one OpenAI-compatible gateway to every
# provider). This is a BYOK app: each user pastes their own OpenRouter key per
# session in the UI and picks any model id (e.g. "anthropic/claude-opus-4.7",
# "openai/gpt-5", "x-ai/grok-4"). Get a key at https://openrouter.ai/keys

# --- Models (OpenRouter) --------------------------------------------------
# Optional operator/CLI fallback key. For a public deploy leave this blank and
# let each session bring its own key. Default model id used when none is set.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-4.7

# --- Dynamic configuration -------------------------------------------------
# Fernet-compatible base64 key for encrypting per-session BYOK API keys in the DB.
# REQUIRED in production: if blank, a random ephemeral key is generated on each
# startup, so stored session keys can't be decrypted after a restart and those
# agents silently fall back to stub.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# How many consecutive API errors before pausing the simulation (default 3).
ERROR_THRESHOLD=3
