# Project Darwin — copy to .env. BYOK app: models go through OpenRouter and each
# user pastes their own key per session in the UI. https://openrouter.ai/keys

# --- Models (OpenRouter) — operator/CLI fallback; leave blank for pure BYOK ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-4.7

# Fernet key encrypting per-session BYOK keys. REQUIRED in prod (blank =
# ephemeral key each startup -> stored keys die on restart). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# How many consecutive API errors before pausing the simulation (default 3).
ERROR_THRESHOLD=3

# Per-agent decision timeout (seconds). Raise for slow reasoning/"pro" models
# (e.g. 300); turns wait for the slowest agent, so higher = slower turns.
AGENT_TIMEOUT_SECONDS=120
