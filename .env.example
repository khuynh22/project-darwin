# Project Darwin — copy to .env and fill in whatever keys you have.
# Leave blanks: missing keys make that single agent run as a deterministic stub
# while the others use real models. So you can start with just ANTHROPIC_API_KEY
# and grow.

# When true, ALL agents are stubs regardless of which keys are set. Useful for
# the first dry run. Flip to false once you've added at least one real key.
#
# IMPORTANT for a public BYOK launch: STUB_MODE is GLOBAL. If it stays true,
# every session runs stub agents and the per-session API keys users paste are
# ignored. Set STUB_MODE=false in production so keyed sessions use real models
# (sessions/agents without a key still fall back to stub automatically).
STUB_MODE=true

# --- API keys (any subset is fine) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=

# --- Model IDs (override when newer SOTA drops) --------------------------
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-3.1-pro-preview
GROK_MODEL=grok-4.3

# --- Ollama (local, no key needed) ----------------------------------------
# Point to your Ollama instance. Use host.docker.internal when running in Docker.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# --- Dynamic configuration -------------------------------------------------
# Fernet-compatible base64 key for encrypting per-session BYOK API keys in the DB.
# REQUIRED in production: if blank, a random ephemeral key is generated on each
# startup, so stored session keys can't be decrypted after a restart and those
# agents silently fall back to stub.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# How many consecutive API errors before pausing the simulation (default 3).
ERROR_THRESHOLD=3
